{
    "name": "ouster-sdk",
    "dependencies": [
        { "name": "curl", "features": ["openssl"] },
        "eigen3",
        "libtins",
        "flatbuffers",
        "glfw3",
        "libpng",
        "gtest",
        "zlib",
        "openssl",
        "tbb",
        "zstd",
        "libzip",
        { "name": "ceres", "features": ["eigensparse"] }
    ],
    "features": {
        "perception": {
            "description": "Support perception dependencies",
            "dependencies": ["cgal"]
        }
    },
    "overrides": [
        {
            "name": "flatbuffers",
            "version": "24.3.25"
        },
        {
            "name": "ceres",
            "version": "2.0.0"
        },
        {
            "name": "gtest",
            "version": "1.16.0"
        },
        {
            "name": "eigen3",
            "version": "3.4.1#1"
        },
        {
            "name": "cgal",
            "version": "6.0.1"
        },
        {
            "name": "mpfr",
            "version": "4.2.2#0"
        }
    ],
    "$comment": "vcpkg-overlay-ports/curl pins curl 8.23.0 for a security fix; remove it once builtin-baseline provides curl >= 8.23.0.",
    "vcpkg-configuration": {
        "overlay-ports": ["./vcpkg-overlay-ports"]
    },
    "builtin-baseline": "879fb16d16efd28730627c2774e007da388731bc",
    "version": "1.0.0"
}
