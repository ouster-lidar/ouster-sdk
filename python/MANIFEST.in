include README.rst CMakeLists.txt mypy.ini tox.ini requirements.txt stubgen_pattern.txt stubgen.py
graft src
graft tests

# add the C++ source via the symlink created by setup.py; prune to avoid a cycle
graft sdk
prune sdk/python
prune sdk/.git
prune sdk/artifacts
prune sdk/sdk-extensions
prune sdk/build
prune sdk/scripts
recursive-exclude sdk Jenkinsfile
prune sdk/venv
prune sdk/.venv
prune sdk/_private
exclude sdk/.gitmodules
exclude sdk/VERSION.generated

# Apply after all grafts: graft sdk re-includes bytecode if these appear earlier.
global-exclude *.py[cod] *.pyo
global-exclude __pycache__
recursive-exclude * __pycache__
recursive-exclude * *.py[cod]
