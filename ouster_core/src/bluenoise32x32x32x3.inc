    fp.write("const std::uint8_t BLUE_NOISE_%dX%dX%dX3[%d][%d][%d][%d] = {\n" % (dim3 + blue_noise.shape))
    for z in range(blue_noise.shape[0]):
        fp.write("{\n")
        for y in range(blue_noise.shape[1]):
            fp.write("  {")
            for x in range(blue_noise.shape[2]):
                fp.write("{%d,%d,%d}," % tuple(blue_noise[z, y, x].tolist()))
            fp.write("},\n")
        fp.write("},\n")
    fp.write("};")
