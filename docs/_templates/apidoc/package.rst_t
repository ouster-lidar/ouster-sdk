{# Package (namespace) template #}
{%- set name = pkgname
    | default(module)
    | default((subpackages and subpackages[0]) or '')
-%}
{%- if not name -%}
.. # Skipped: package name unresolved
{%- else -%}
{{ name }}
{{ "=" * name|length }}

Module contents
---------------

.. automodule:: {{ name }}
   :show-inheritance:

{% if subpackages %}
Subpackages
-----------

{% if name == "ouster.sdk" %}
{# Main package landing: show only top-level package links #}
.. toctree::
   :maxdepth: 1
   :titlesonly:

{% for subpkg in subpackages | sort %}
   {{ subpkg }}
{% endfor %}

{% else %}
{# Other packages: use titles only #}
.. toctree::
   :maxdepth: 2
   :titlesonly:

{% for subpkg in subpackages | sort %}
   {{ subpkg }}
{% endfor %}
{% endif %}
{% endif %}

{% if submodules %}
{% if name == "ouster.sdk" %}

{# Top-level package landing: show only top-level submodule links #}
Submodules
----------

.. toctree::
   :maxdepth: 1
   :titlesonly:

{% for submod in submodules | sort %}
   {{ submod.replace(' module', '') }}
{% endfor %}

{% else %}

{# Package landing: inline submodule docs on this page (same-page anchors for Classes/Functions) #}
Submodules
----------

{% for submod in submodules | sort %}
{%- set mod_name = submod.replace(' module', '') %}

{{ mod_name }}
{{ "--" * (mod_name|length + 7) }}

.. automodule:: {{ submod }}
   :members:
   :member-order: alphabetical
   :undoc-members:
   :show-inheritance:

{% endfor %}
{% endif %}
{% endif %}
{%- endif -%}